OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Despite the name, this is an Event Registry (eventregistry.org / newsapi.ai)
# API key, not a newsapi.org key. Free tier: 2,000 tokens; a recent-data article
# search costs 1 token, so ~2,000 searches/month.
NEWSAPI_KEY=your_key_here
